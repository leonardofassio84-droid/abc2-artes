# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5

# --- WhatsApp Business (Meta Cloud API) ---
# Token permanente do usuário de sistema (Business Manager > Usuários do sistema)
WHATSAPP_TOKEN=EAAG...
# ID do número de telefone (WhatsApp > Configuração da API)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Chave secreta do app (Configurações do app > Básico) - valida a assinatura do webhook
WHATSAPP_APP_SECRET=
# Texto qualquer que você escolhe e repete na tela de configuração do webhook
WHATSAPP_VERIFY_TOKEN=minha-senha-de-verificacao
GRAPH_API_VERSION=v23.0

# --- Segurança ---
# Números autorizados a falar com o assessor (com DDI, só dígitos, separados por vírgula)
ALLOWED_NUMBERS=5511999999999
# Token para baixar os registros em CSV: GET /registros.csv?token=...
EXPORT_TOKEN=troque-este-token

# --- Geral ---
DB_PATH=assessor.db
TIMEZONE=America/Sao_Paulo
NOME_ASSESSOR=Assessor
